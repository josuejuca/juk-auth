{
  "expo": {
    "name": "JUK Authenticator",
    "slug": "crecidf",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jukauth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos o Face ID para proteger seus códigos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.josuejuca.crecidf"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.josuejuca.crecidf",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O JUK Authenticator usa a câmera para ler o QR code de configuração das suas contas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos o Face ID para proteger seus códigos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0B0E14"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Escuro",
            "ios": "./assets/app-icons/escuro.png",
            "android": {
              "foregroundImage": "./assets/app-icons/escuro-fg.png",
              "backgroundColor": "#0B0E14"
            }
          },
          {
            "name": "Azul",
            "ios": "./assets/app-icons/azul.png",
            "android": {
              "foregroundImage": "./assets/app-icons/azul-fg.png",
              "backgroundColor": "#1465BB"
            }
          },
          {
            "name": "Verde",
            "ios": "./assets/app-icons/verde.png",
            "android": {
              "foregroundImage": "./assets/app-icons/verde-fg.png",
              "backgroundColor": "#048002"
            }
          },
          {
            "name": "Laranja",
            "ios": "./assets/app-icons/laranja.png",
            "android": {
              "foregroundImage": "./assets/app-icons/laranja-fg.png",
              "backgroundColor": "#FCA61F"
            }
          },
          {
            "name": "Vermelho",
            "ios": "./assets/app-icons/vermelho.png",
            "android": {
              "foregroundImage": "./assets/app-icons/vermelho-fg.png",
              "backgroundColor": "#A6140D"
            }
          },
          {
            "name": "Ceu",
            "ios": "./assets/app-icons/ceu.png",
            "android": {
              "foregroundImage": "./assets/app-icons/ceu-fg.png",
              "backgroundColor": "#57A3F2"
            }
          },
          {
            "name": "Menta",
            "ios": "./assets/app-icons/menta.png",
            "android": {
              "foregroundImage": "./assets/app-icons/menta-fg.png",
              "backgroundColor": "#15803D"
            }
          },
          {
            "name": "Grafite",
            "ios": "./assets/app-icons/grafite.png",
            "android": {
              "foregroundImage": "./assets/app-icons/grafite-fg.png",
              "backgroundColor": "#27272A"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "josuejuca",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "623c5cd3-a786-48ce-b372-07ef4311f3ad"
      }
    }
  }
}
