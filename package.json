    "expo-alternate-app-icons": "^11.0.0",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
